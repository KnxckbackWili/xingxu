# ============================================================
# 本文件用于 SQLite 基线部署（docker/docker-compose.yml + manage.sh）。
# 正式 8002 部署（容器内 PostgreSQL）请改用 docker/.env.example：
#   cp docker/.env.example docker/.env
#   二次部署执行 make update 即可，通常无需改动任何变量。
# ============================================================

# Optional: leave empty to persist an automatically generated key in data/secret.key.
SECRET_KEY=
# 独立会话签名密钥；公网部署使用私有随机值，轮换后需重新登录。
# 留空兼容旧部署。历史数据加密仍使用上面的 SECRET_KEY。
AUTH_SIGNING_KEY=

# Production default is 0. Set to 1 only for local demonstrations.
SEED_DEMO_USERS=0

# Required for the first production startup. Use at least 8 characters.
INITIAL_ADMIN_PASSWORD=

# 存量 admin 密码轮换：已存在 admin 账号时，置为 1 且同时提供
# INITIAL_ADMIN_PASSWORD（或演示模式 DEMO_ADMIN_PASSWORD）即可在下次启动时
# 显式轮换密码，并让所有已登录会话失效。密码未变时幂等跳过。
# 轮换完成后建议移除本变量，避免每次重启都重复轮换。
# 明文只从环境变量读取，不会写入日志或落盘。
ADMIN_PASSWORD_ROTATE=0

# 演示账号密码轮换（SEED_DEMO_USERS=1 时生效）：对外暴露前必须设置，避免使用
# 默认的 admin123/pm123/worker123。留空则沿用预计算默认哈希（仅限本地演示）。
DEMO_ADMIN_PASSWORD=
DEMO_PM_PASSWORD=
DEMO_WORKER_PASSWORD=

# Optional comma-separated origins for a separate development frontend.
CORS_ORIGINS=

# NAS 反向代理场景：默认仅本机监听，避免直接把 8000 暴露到公网。
# build：NAS 从源码构建；registry：拉取已发布的版本镜像。
DEPLOY_MODE=build
APP_VERSION=4.0.0
# 始终固定版本，生产环境不要使用 latest。
AGV_IMAGE=agv-pm:4.0.0
BIND_ADDRESS=127.0.0.1
APP_PORT=8000
DATA_PATH=../data
# 更新前完整备份与回滚状态，建议放在 data/ 之外。
BACKUP_DIR=backups

# Host 校验白名单（逗号分隔，代码默认未配置时为 *）：支持
#   精确域名/IP：按 Host 头精确匹配（如 localhost、agv.example.com、192.168.1.42）
#   *.example.com：匹配该域任意子域
#   192.168.1.0/24：IP 网段（CIDR，匹配局域网该网段任意 IP，DHCP 换 IP/新增网卡不失效）
# 公网反代场景必须包含公网域名，否则反代访问会 400 Invalid host header。
# 生产不建议留 *（Host 头投毒风险）：部署时应显式列出公网域名与内网 IP；
# 反代场景再加 NPM/nginx 可信转发头网段（FORWARDED_ALLOW_IPS）。
PUBLIC_MODE=0
TRUSTED_HOSTS=*
# 公网模式必须显式配置代理IP；禁止 *、空值及全地址网段。
FORWARDED_ALLOW_IPS=
# 公网访问必须设 PUBLIC_MODE=1，并同时设 FORCE_HTTPS=1、COOKIE_SECURE=1。
# FORCE_HTTPS=1 会将业务HTTP请求重定向到HTTPS；反代应覆盖客户端转发头。
FORCE_HTTPS=0
# 浏览器会话走 HttpOnly Cookie + CSRF 双提交（HYPE-99）：本地/内网 HTTP 必须为 0，
# 否则浏览器不写 Secure Cookie（登录后无会话）；HTTPS 反代前置后设 1，Cookie 才带 Secure。
COOKIE_SECURE=0
# 会话 Cookie SameSite：lax（默认，推荐）/ strict / none（none 必须同时 COOKIE_SECURE=1）。
COOKIE_SAMESITE=lax
MAX_BACKUP_UPLOAD_MB=2048
# 恢复包解压后的总量上限；应大于现有 data 目录总量。
MAX_BACKUP_EXPANDED_MB=8192

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.5-pro
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7

# O2 unhealthy 自愈看门狗（容器内 supervisord 托管，保持单容器形态）：
# 连续失败 HEALTH_FAIL_THRESHOLD 次 → 重启 web 进程；web 重启达
# HEALTH_WEB_RESTART_LIMIT 次仍未恢复 → 关停容器触发 restart: unless-stopped。
# 应用首次成功前 HEALTH_START_GRACE 秒内只观察不动作（避免启动阶段误判）。
HEALTH_CHECK_URL=http://127.0.0.1:8000/health
HEALTH_CHECK_INTERVAL=15
HEALTH_FAIL_THRESHOLD=3
HEALTH_WEB_RESTART_LIMIT=2
HEALTH_START_GRACE=180

# 单个上传文件的大小上限（MiB）。0 表示不限。
MAX_UPLOAD_MB=200
