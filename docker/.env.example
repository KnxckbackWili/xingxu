# 8002 单容器 PostgreSQL 部署（Multica 正式部署）—— 只需按需填写以下少量变量。
# 将本文件复制为 docker/.env（chmod 600）后按需填写；不填的项使用内置默认值。
# 二次部署（make update）通常无需改动任何变量：更新代码后直接执行 make update 即可。
# 注意：本文件放 docker/ 目录（compose 从 docker/ 读取 .env）；仓库根目录的 .env.example 仅用于 SQLite 基线。

# 首次部署必填：admin 初始密码（≥8 位）。SEED_DEMO_USERS=0（默认，正式）时未设置会导致首次启动失败。
# 二次部署（数据已存在）时忽略该值。
INITIAL_ADMIN_PASSWORD=

# 公网部署使用独立随机会话签名密钥，放私有环境文件；轮换需重启并重新登录。
# 留空兼容旧部署。SECRET_KEY 是历史数据加密密钥，不随会话轮换。
AUTH_SIGNING_KEY=

# 0=仅创建 admin（正式，默认）；1=额外创建演示账号（评审/演示用，生产不建议）。
# 即使设 1，seed 也会幂等禁用仍持默认口令（pm123/worker123）的存量演示账号并失效其旧会话。
SEED_DEMO_USERS=0
# 需保留演示角色时，先为演示账号轮换为强口令：
# DEMO_ADMIN_PASSWORD=
# DEMO_PM_PASSWORD=
# DEMO_WORKER_PASSWORD=

# 存量 admin 运维轮换：设 1 且提供 INITIAL_ADMIN_PASSWORD(≥8位) 时，启动时显式改密并
# 使旧会话全部失效（幂等；见 docs/deployment.md）。轮换完成后建议移除，避免每次重启重复轮换。
ADMIN_PASSWORD_ROTATE=0

# Host 校验白名单（逗号分隔）：精确域名/IP、*.domain 子域、IP 网段（CIDR）。
# 默认仅本机回环（127.0.0.1,localhost），通过 IP/域名访问必须显式加入。
# 示例（按需自行修改，不要作为默认值放开网段）：
#   TRUSTED_HOSTS=127.0.0.1,localhost,agv.example.com,192.168.1.0/24
PUBLIC_MODE=0
TRUSTED_HOSTS=127.0.0.1,localhost
# 公网部署设为1；同时必须COOKIE_SECURE=1并配置明确代理IP。
FORCE_HTTPS=0
# 反代位于本机时仅绑定回环；内网直连可显式设0.0.0.0。
BIND_ADDRESS=127.0.0.1

# 反向代理（NPM/nginx）可信地址/网段：仅该地址转发的 X-Forwarded-For/Proto 被信任
# （拿到真实客户端 IP 与 https scheme）。容器默认空值不信任代理头。
# 公网模式只允许明确IP或专用网段（应仅覆盖实际代理），禁止 * 和空值。
# 反代场景收敛到 NPM 容器 IP，如 172.17.0.5。详见 docs/deployment.md。
FORWARDED_ALLOW_IPS=

# 浏览器会话 Cookie 安全属性（HYPE-99）：NPM/nginx 终止 HTTPS 后容器内 uvicorn 看到的是 http，
# 必须在 docker/.env 设 COOKIE_SECURE=1 才给会话 Cookie 打 Secure，否则浏览器在 https 页面
# 拒绝非 Secure 的 HttpOnly Cookie → 登录后无法保持会话。本地/内网 http 直连保持 0。
COOKIE_SECURE=0
# 会话 Cookie SameSite：lax（默认）/ strict / none（none 必须同时 COOKIE_SECURE=1）。
COOKIE_SAMESITE=lax

# uvicorn worker 数（多 worker 共享容器内 PostgreSQL）。
WEB_CONCURRENCY=2

# 项目原件分片上传上限（MiB）；默认2048即2GiB。旧内存型配置/表格导入仍限10MiB。
MAX_UPLOAD_MB=2048

# ---- 可选：AI 项目整理助手（不配置不影响手工业务） ----
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# MIMO_API_KEY=
# MINIMAX_API_KEY=
